#!/usr/bin/bash

# To do: For cylc 7 we may want to consider which log dir the cycles came from
# and put them in the correct one on Jasmin,
# otherwise the cycles can get out of order in processing. 

# Check required env vars are set correctly
check_env_vars() { 
  if [[ ! -f $SUITE_STATUS ]]; then 
    echo "Error: Suite status file $SUITE_STATUS does not exist" >&2
    exit 99
  fi
  echo "Archive dir: $ARCHIVE_DIR"
  echo "Report dir: $REPORT_DIR"
  echo "Report file: $REPORT_FILE"
  echo "Sci host: $SCI_HOST"
  echo "Suite status: $SUITE_STATUS"
}

# Clearout log report and missing file lists from previous iterations.
clear_previous_runs() {
  rm log_report.csv
  rm *missing*
} 

# Copy log report and list of missing cycles from Jasmin. 
get_log_reports() {
  scp $SCI_HOST:$REPORT_DIR/log_report.csv .
  scp $SCI_HOST:$REPORT_DIR/*missing* .
}

# Get suite-id from missing cycle file, then lookup
# info required: user and whether cylc 8.
# Derive Jasmin dir and puma2 dir
get_suite_details() {
  SUITE=$(echo $FILE | cut -c1-7) 
  USER=$(grep $SUITE $SUITE_STATUS | cut -d',' -f2)
  CYLC8=$(grep $SUITE $SUITE_STATUS | cut -d',' -f16)
  RUN=$(grep $SUITE $SUITE_STATUS | cut -d',' -f17)
  JASMIN_DIR=$ARCHIVE_DIR/$SUITE/    
  PUMA2_SUITE_DIR=/home/n02/n02/$USER/cylc-run/$SUITE
}

# Check the Puma2 log dir exists 
check_dir() {
  if [[ ! -d "$PUMA2_SUITE_DIR" ]]; then 
    echo "Error: $PUMA2_SUITE_DIR does not exist" >&2	
    local lost_files=$(wc -l < $FILE)
    ((ERR_COUNT+=lost_files))
    return 1
  fi 
}

# Cylc 7: Try to find tarred job file for cycle. 
# Look under all log.* dirs.
# May find more than one job cycle file if run was restarted.
# Print path(s) if found. 
locate_cylc7_job_file() {
  for log_dir in log.*; do 
    local job_file=$PUMA2_SUITE_DIR/$log_dir/job-$CYCLE.tar.gz 
    if [[ -f $job_file ]]; then 
      echo $job_file
    fi 
  done 
} 

# Cylc 8: Try to find tarred job file for cycle. 
# Print path if found 
locate_cylc8_job_file() {
  local job_file=$PUMA2_SUITE_DIR/run$RUN/log/job-$CYCLE.tar.gz
  if [[ -f $job_file ]]; then 
    echo $job_file
  fi 
} 

# Try to find tarred job file for cycle.
# Outputs full path of job file(s) if found 
# Returns 1 if cycle not found. 
locate_job_file() { 
  cd $PUMA2_SUITE_DIR
  if [[ "$CYLC8" == "True" ]]; then
    job_file=$(locate_cylc8_job_file)
  else
    job_file=$(locate_cylc7_job_file)
  fi
  if [[ -z "$job_file" ]]; then
    echo "Error: Cycle $CYCLE not found in suite dir $PUMA2_SUITE_DIR" >&2
    return 1
  else
    echo $job_file
  fi 
} 

# For each missing cycle, find the job file on Puma2
get_job_files() {
  JOB_FILES=""
  for CYCLE in $(cat $FILE); do
    JOB_FILES+=$(locate_job_file)" " || ((ERR_COUNT+=1))
  done
} 

# Copy job files to Jasmin
sync_files() {
  echo "Syncing $SUITE"
  rsync $JOB_FILES $SCI_HOST:$JASMIN_DIR
}

# Loop through suite missing cycle files, find tarred job logs 
# and copy to Jasmin. 
sync_missing_cycles() { 
  ERR_COUNT=0
  for FILE in u-*.txt; do
    get_suite_details
    check_dir || continue 
    get_job_files 
    sync_files
  done
}

# Write report with number of job cycles not found. 
error_report() {
  if [[ $ERR_COUNT > 0 ]]; then  
    echo "Error: Failed to find $ERR_COUNT cycles." >&2
    exit $ERR_COUNT
  fi 
}

# For each suite with missing files, look in log dir on puma2
# and attempt to find tarred job files. Then copy to Jasmin log dir.
# Returns error code equal to number of job cycle dirs not found.  
main() {
  check_env_vars
  clear_previous_runs
  get_log_reports
  sync_missing_cycles
  error_report
} 

main "$@"
